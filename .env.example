# Database (PlanetScale MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST/DATABASE?sslaccept=strict"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# UploadThing (File uploads)
UPLOADTHING_SECRET=sk_live_xxxxxxxxxxxx
UPLOADTHING_APP_ID=xxxxxxxxxxxx

# LiveKit (Audio/Video)
LIVEKIT_API_KEY=xxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxx
NEXT_PUBLIC_LIVEKIT_URL=wss://xxxxxxxxxxxx.livekit.cloud

# Site URL (used for Socket.IO connection)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
